NVIDIA_API_KEY=nvapi-FIXME
HF_TOKEN=hf_FIXME
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

#EXTERNAL_MINIO_BASE_URL=127.0.0.1:9010
#[OR]
INTERNAL_MINIO_BASE_URL=127.0.0.1:9010
EXTERNAL_MINIO_BASE_URL=s3.ap-southeast-1.amazonaws.com
EXTERNAL_PHOTO_BASE_URL=aih-photo-booth-app.s3.ap-southeast-1.amazonaws.com
EXTERNAL_MINIO_ACCESS_KEY=FIXME
EXTERNAL_MINIO_SECRET_KEY=FIXME
EXTERNAL_MINIO_BUCKET=aih-photo-booth-app

# Wireless Reachy Mini IP, used by the camera and robot-controller services.
# Update with: scripts/reachy-ip.sh   (or edit here, then recreate those two)
REACHY_HOST=192.168.0.19

# Speaker for the robot voice: a PipeWire output name, empty = host default output.
# List/switch with: scripts/audio-output.sh
AUDIO_SINK=bluez_output.7C_2A_CA_D1_F5_0E.1

# Microphone for speech-to-text: a PipeWire source name, empty = host default input.
# List/switch with: scripts/audio-input.sh
AUDIO_SOURCE=alsa_input.usb-145f_KO-STAR_M-640S-00.analog-stereo
